#ifndef MOVEMENT_H
#define MOVEMENT_H

#include "open_interface.h"

/**
 * @name Has Collided on the left side
 * @param sensor
 * @returns if the left has collided
 */
int has_collided_left(oi_t *sensor);

/**
 * @name Has Collided on the right side
 * @param sensor
 * @returns if the right has collided
 */
int has_collided_right(oi_t *sensor);

/**
 * @name Has Collided on either side
 * @param sensor
 * @returns if the has collided
 */
int has_collided(oi_t *sensor);

/**
 * @name Move Forward
 * @param sensor 
 * @param centimeters
 */
void move_forward(oi_t *sensor, int centimeters);

/**
 * @name Turn Clockwise
 * @param sensor
 * @param degrees
 */
void turn_cw(oi_t *sensor, int degrees);

/**
 * @name Turn Counter-clockwise
 * @param sensor
 * @param degrees
 */
void turn_ccw(oi_t *sensor, int degrees);

/**
 * @name Avoid obstacle
 * @param sensor
 */
void avoid(oi_t *sensor);

#endif
