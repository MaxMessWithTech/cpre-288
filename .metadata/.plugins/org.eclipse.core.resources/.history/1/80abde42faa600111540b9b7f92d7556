#include "open_interface.h"
#include <stdio.h>

void step_2();
void step_3();
void step_4();

/**
 * main.c
 * @author Max Miller
 */
int main(void) {
    step_3();

}


void step_2() {
    oi_t *sensor_data = oi_alloc();

    oi_init(sensor_data);

    double sum = 0;

    oi_setWheels(500, 500); // move forward; full speed

    while (sum < 1000) {
        oi_update(sensor_data);
        sum += sensor_data->distance;
    }

    oi_setWheels(0, 0); // stop
    oi_free(sensor_data);

}

void step_3() {
    oi_t *sensor = oi_alloc();

    oi_init(sensor);

    oi_setMotorCalibration(1.0,1.0);

    int i, j;

    for (i = 0; i < 4; i++) {
        for (j = 0; j < 4; j++) {
            move_forward(sensor, 50);
            turn_cw(sensor, 90);
        }

    }

    oi_free(sensor);
}

void step_4() {
    oi_t *sensor = oi_alloc();

    oi_init(sensor);

    move_forward(sensor, 200);

    oi_free(sensor);
}
